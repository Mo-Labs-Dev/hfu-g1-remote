                                                            tr(
                                                                language,
                                                                "Robot status: Not connected",
                                                                "Roboterstatus: Nicht verbunden"
                                                            ),
                                                            color = Muted,
                                                            fontSize = 11.sp
                                                        )
                                                    }

                                                    Column(
                                                        modifier = Modifier
                                                            .width(226.dp)
                                                            .padding(end = 16.dp, top = 6.dp, bottom = 6.dp),
                                                        horizontalAlignment = Alignment.CenterHorizontally,
                                                        verticalArrangement = Arrangement.spacedBy(5.dp)
                                                    ) {
                                                        Text(
                                                            tr(language, "Connecting Humans and Robots", "Menschen und Roboter verbinden"),
                                                            color = Green,
                                                            fontWeight = FontWeight.Bold,
                                                            fontSize = 14.sp,
                                                            lineHeight = 17.sp,
                                                            textAlign = androidx.compose.ui.text.style.TextAlign.Center,
                                                            maxLines = 2
                                                        )

                                                        Text(
                                                            tr(language, "Ask G1 about the laboratory", "Frag G1 über das Labor"),
                                                            color = Muted,
                                                            fontSize = 10.sp,
                                                            textAlign = androidx.compose.ui.text.style.TextAlign.Center,
                                                            maxLines = 1
                                                        )

                                                        Button(
                                                            onClick = { onNavigate(Screen.VOICE) },
                                                            modifier = Modifier
                                                                .fillMaxWidth()
                                                                .height(38.dp),
                                                            shape = RoundedCornerShape(50),
                                                            contentPadding = PaddingValues(horizontal = 10.dp, vertical = 4.dp)
                                                        ) {
                                                            Icon(
                                                                Icons.Default.Mic,
                                                                contentDescription = null,
                                                                modifier = Modifier.size(17.dp)
                                                            )
                                                            Spacer(Modifier.width(8.dp))
                                                            Text(
                                                                tr(language, "Talk to G1", "Mit G1 sprechen"),
                                                                fontSize = 12.sp,
                                                                fontWeight = FontWeight.Bold
                                                            )
                                                            Spacer(Modifier.width(8.dp))
                                                            Icon(
                                                                Icons.Default.ArrowForward,
                                                                contentDescription = null,
                                                                modifier = Modifier.size(15.dp)
                                                            )
                                                        }
                                                    }
                                                }
                                            }

                                            // ORIGINAL CARD ROW
                                            Row(
                                                modifier = Modifier.fillMaxWidth(),
                                                horizontalArrangement = Arrangement.spacedBy(10.dp)
                                            ) {

                                                cards.forEach { card ->

                                                    Card(
                                                        modifier = Modifier
                                                            .weight(1f)
                                                            .height(180.dp)
                                                            .clickable {
                                                                onNavigate(card.screen)
                                                            },
                                                        shape = RoundedCornerShape(16.dp),
                                                        colors = CardDefaults.cardColors(
                                                            containerColor = Color.White
                                                        ),
                                                        elevation = CardDefaults.cardElevation(
                                                            defaultElevation = 2.dp
                                                        )
                                                    ) {

                                                        Column {

                                                            Image(
                                                                painter = painterResource(card.image),
                                                                contentDescription = card.title,
                                                                modifier = Modifier
                                                                    .fillMaxWidth()
                                                                    .height(120.dp),
                                                                contentScale = ContentScale.Crop
                                                            )

                                                            Row(
                                                                modifier = Modifier
                                                                    .fillMaxWidth()
                                                                    .padding(9.dp),
                                                                verticalAlignment = Alignment.CenterVertically
                                                            ) {

                                                                Text(
                                                                    card.title,
                                                                    modifier = Modifier.weight(1f),
                                                                    fontSize = 12.sp,
                                                                    fontWeight = FontWeight.Bold,
                                                                    color = Dark,
                                                                    maxLines = 2,
                                                                    lineHeight = 14.sp
                                                                )

                                                                Icon(
                                                                    Icons.Default.ArrowForward,
                                                                    contentDescription = null,
                                                                    tint = Green,
                                                                    modifier = Modifier.size(16.dp)
                                                                )
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Notice(
                                                "Visitor interface preview. Robot actions " +
                                                        "will be controlled by G1 Studio."
                                            )
                                        }
                                    }


// ======================================================
// SAFETY PRESENTATION
// ======================================================

                                    @Composable
                                    private fun SafetyPresentationScreen(
                                        onHome: () -> Unit
                                    ) {
                                        var currentSlide by remember { mutableIntStateOf(0) }
                                        var playing by remember { mutableStateOf(false) }
                                        var finished by remember { mutableStateOf(false) }

                                        LaunchedEffect(playing, currentSlide) {
                                            if (playing) {
                                                delay(8000L)
                                                if (currentSlide < safetySlides.lastIndex) {
                                                    currentSlide++
                                                } else {
                                                    playing = false
                                                    finished = true
                                                }
                                            }
                                        }

                                        val slide = safetySlides[currentSlide]

                                        Column(
                                            modifier = Modifier
                                                .fillMaxSize()
                                                .background(Color.White)
                                                .padding(horizontal = 14.dp, vertical = 8.dp),
                                            verticalArrangement = Arrangement.spacedBy(7.dp)
                                        ) {
                                            Row(
                                                modifier = Modifier
                                                    .fillMaxWidth()
                                                    .height(42.dp),
                                                verticalAlignment = Alignment.CenterVertically
                                            ) {
                                                Icon(
                                                    Icons.Default.HealthAndSafety,
                                                    contentDescription = null,
                                                    tint = Green
                                                )

                                                Spacer(Modifier.width(8.dp))

                                                Text(
                                                    "HFU IPSE",
                                                    color = Green,
                                                    fontSize = 15.sp,
                                                    fontWeight = FontWeight.Bold
                                                )

                                                Spacer(Modifier.width(12.dp))

                                                Text(
                                                    "Laboratory Safety Presentation",
                                                    modifier = Modifier.weight(1f),
                                                    color = Dark,
                                                    fontSize = 17.sp,
                                                    fontWeight = FontWeight.Bold
                                                )

                                                Text(
                                                    "${currentSlide + 1} / ${safetySlides.size}",
                                                    color = Green,
                                                    fontWeight = FontWeight.Bold
                                                )

                                                IconButton(
                                                    onClick = {
                                                        playing = false
                                                        onHome()
                                                    }
                                                ) {
                                                    Icon(Icons.Default.Close, "Close")
                                                }
                                            }

                                            Box(
                                                modifier = Modifier
                                                    .fillMaxWidth()
                                                    .weight(1f)
                                                    .clip(RoundedCornerShape(14.dp))
                                                    .background(Mint)
                                            ) {
                                                Image(
                                                    painter = painterResource(slide.image),
                                                    contentDescription = slide.title,
                                                    modifier = Modifier.fillMaxSize(),
                                                    contentScale = ContentScale.Crop
                                                )

                                                Surface(
                                                    modifier = Modifier
                                                        .align(Alignment.TopStart)
                                                        .padding(12.dp),
                                                    color = Color.White.copy(alpha = 0.94f),
                                                    shape = RoundedCornerShape(10.dp)
                                                ) {
                                                    Text(
                                                        "VISITOR SAFETY · EXAMPLE",
                                                        modifier = Modifier.padding(10.dp),
                                                        color = Green,
                                                        fontWeight = FontWeight.Bold,
                                                        fontSize = 11.sp
                                                    )
                                                }
                                            }

                                            Text(
                                                slide.title,
                                                color = Dark,
                                                fontSize = 23.sp,
                                                fontWeight = FontWeight.Bold
                                            )

                                            Text(
                                                slide.subtitle,
                                                color = Muted,
                                                fontSize = 12.sp
                                            )

                                            Surface(
                                                color = Mint,
                                                shape = RoundedCornerShape(10.dp)
                                            ) {
                                                Row(
                                                    modifier = Modifier.padding(10.dp),
                                                    verticalAlignment = Alignment.CenterVertically
                                                ) {
                                                    Icon(
                                                        Icons.Default.RecordVoiceOver,
                                                        null,
                                                        tint = Green
                                                    )

                                                    Spacer(Modifier.width(10.dp))

                                                    Column {
                                                        Text(
                                                            when {
                                                                finished -> "Preview completed"
                                                                playing -> "Narration preview · Playing"
                                                                else -> "Narration preview · Paused"
                                                            },
                                                            color = Green,
                                                            fontSize = 11.sp,
                                                            fontWeight = FontWeight.Bold
                                                        )

                                                        Text(
                                                            slide.narration,
                                                            color = Dark,
                                                            fontSize = 12.sp,
                                                            maxLines = 3,
                                                            overflow = TextOverflow.Ellipsis
                                                        )
                                                    }
                                                }
                                            }

                                            LinearProgressIndicator(
                                                progress = {
                                                    (currentSlide + 1).toFloat() /
                                                            safetySlides.size.toFloat()
                                                },
                                                modifier = Modifier.fillMaxWidth(),
                                                color = Green
                                            )

                                            Row(
                                                horizontalArrangement = Arrangement.spacedBy(10.dp),
                                                verticalAlignment = Alignment.CenterVertically
                                            ) {
                                                OutlinedButton(
                                                    onClick = {
                                                        playing = false
                                                        finished = false
                                                        currentSlide =
                                                            (currentSlide - 1).coerceAtLeast(0)
                                                    },
                                                    enabled = currentSlide > 0
                                                ) {
                                                    Icon(Icons.Default.SkipPrevious, null)
                                                    Text("Previous")
                                                }

                                                Button(
                                                    onClick = {
                                                        if (finished) {
                                                            currentSlide = 0
                                                            finished = false
                                                            playing = true
                                                        } else {
                                                            playing = !playing
                                                        }
                                                    }
                                                ) {
                                                    Icon(
                                                        if (playing) Icons.Default.Pause
                                                        else Icons.Default.PlayArrow,
                                                        null
                                                    )
                                                    Text(
                                                        when {
                                                            finished -> "Replay"
                                                            playing -> "Pause"
                                                            else -> "Play Preview"
                                                        }
                                                    )
                                                }

                                                OutlinedButton(
                                                    onClick = {
                                                        playing = false
                                                        finished = false
                                                        currentSlide =
                                                            (currentSlide + 1)
                                                                .coerceAtMost(safetySlides.lastIndex)
                                                    },
                                                    enabled = currentSlide < safetySlides.lastIndex
                                                ) {
                                                    Text("Next")
                                                    Icon(Icons.Default.SkipNext, null)
                                                }

                                                Spacer(Modifier.weight(1f))

                                                Text(
                                                    "8 sec / slide · No robot connection",
                                                    color = Muted,
                                                    fontSize = 10.sp
                                                )
                                            }
                                        }
                                    }

// ======================================================
// SHARED COMPONENTS
