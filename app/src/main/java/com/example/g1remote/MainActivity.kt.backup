) {

    data class HomeTile(
        val title: String,
        val image: Int,
        val screen: Screen
    )

    val cards = listOf(
        HomeTile(
            tr(
                language,
                "Lab Guide",
                "Laborführung"
            ),
            R.drawable.lab_guide,
            Screen.LAB_GUIDE
        ),

        HomeTile(
            tr(
                language,
                "Demonstrations",
                "Demonstrationen"
            ),
            R.drawable.demonstration,
            Screen.DEMONSTRATIONS
        ),

        HomeTile(
            tr(
                language,
                "Lab Map",
                "Laborplan"
            ),
            R.drawable.lab_map,
            Screen.LAB_MAP
        ),

        HomeTile(
            tr(
                language,
                "Lab Info",
                "Laborinfo"
            ),
            R.drawable.lab_info,
            Screen.LAB_INFO
        ),

        HomeTile(
            tr(
                language,
                "Safety Presentation",
                "Sicherheit"
            ),
            R.drawable.robot2,
            Screen.SAFETY_PRESENTATION
        )
    )

    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(rememberScrollState())
            .padding(14.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {

        // ORIGINAL G1 BANNER
        Card(
            colors = CardDefaults.cardColors(
                containerColor = Mint
            ),
            shape = RoundedCornerShape(18.dp)
        ) {

            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(130.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {

                Image(
                    painter = painterResource(R.drawable.robot),
                    contentDescription = "G1",
                    modifier = Modifier
                        .width(185.dp)
                        .fillMaxHeight(),
                    contentScale = ContentScale.Crop
                )

                Column(
                    modifier = Modifier
                        .weight(1f)
                        .padding(14.dp)
                ) {

                    Text(
                        "Unitree G1",
                        fontSize = 23.sp,
                        fontWeight = FontWeight.Bold,
                        color = Dark
                    )

                    Text(
                        tr(
                            language,
                            "Humanoid Robot",
                            "Humanoider Roboter"
                        ),
                        fontSize = 13.sp,
                        color = Muted
                    )

                    Spacer(Modifier.height(6.dp))

                    Text(
                        tr(
                            language,
                            "Robot status: Not connected",
                            "Roboterstatus: Nicht verbunden"
                        ),
                        color = Muted,
                        fontSize = 11.sp
                    )
                }

                Column(
                    modifier = Modifier
                        .width(226.dp)
                        .padding(end = 16.dp, top = 6.dp, bottom = 6.dp),
                    horizontalAlignment = Alignment.CenterHorizontally,
                    verticalArrangement = Arrangement.spacedBy(5.dp)
                ) {
                    Text(
                        tr(language, "Connecting Humans and Robots", "Menschen und Roboter verbinden"),
                        color = Green,
                        fontWeight = FontWeight.Bold,
                        fontSize = 14.sp,
                        lineHeight = 17.sp,
                        textAlign = androidx.compose.ui.text.style.TextAlign.Center,
                        maxLines = 2
                    )

                    Text(
                        tr(language, "Ask G1 about the laboratory", "Frag G1 über das Labor"),
                        color = Muted,
                        fontSize = 10.sp,
                        textAlign = androidx.compose.ui.text.style.TextAlign.Center,
                        maxLines = 1
                    )

                    Button(
                        onClick = { onNavigate(Screen.VOICE) },
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(38.dp),
                        shape = RoundedCornerShape(50),
                        contentPadding = PaddingValues(horizontal = 10.dp, vertical = 4.dp)
                    ) {
                        Icon(
                            Icons.Default.Mic,
                            contentDescription = null,
                            modifier = Modifier.size(17.dp)
                        )
                        Spacer(Modifier.width(8.dp))
                        Text(
                            tr(language, "Talk to G1", "Mit G1 sprechen"),
                            fontSize = 12.sp,
                            fontWeight = FontWeight.Bold
                        )
                        Spacer(Modifier.width(8.dp))
                        Icon(
                            Icons.Default.ArrowForward,
                            contentDescription = null,
                            modifier = Modifier.size(15.dp)
                        )
                    }
                }
            }
        }

        // ORIGINAL CARD ROW
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(10.dp)
        ) {

            cards.forEach { card ->

                Card(
                    modifier = Modifier
                        .weight(1f)
                        .height(180.dp)
                        .clickable {
                            onNavigate(card.screen)
                        },
                    shape = RoundedCornerShape(16.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = Color.White
