// ======================================================
// MAIN ACTIVITY
// ======================================================

class MainActivity : ComponentActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        requestedOrientation =
            ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE

        enableEdgeToEdge()

        setContent {
            G1RemoteTheme {
                MaterialTheme(
                    colorScheme = lightColorScheme(
                        primary = Green,
                        background = Background,
                        surface = Color.White
                    )
                ) {
                    G1RemoteApp()
                }
            }
        }
    }
}

// ======================================================
// APP NAVIGATION
// ======================================================

@Composable
private fun G1RemoteApp() {
    var backendStatus by remember {
        mutableStateOf<G1Backend.ConnectionStatus?>(null)
    }

    LaunchedEffect(Unit) {
        while (true) {
            backendStatus = G1Backend.checkConnection()
            delay(5000L)
        }
    }

    var screen by remember {
        mutableStateOf(Screen.HOME)
    }

    // NEW: English / German
    var language by remember {
        mutableStateOf(AppLanguage.EN)
    }

    var selectedDestination by remember {
        mutableStateOf(destinations.first())
    }

    var selectedDemo by remember {
        mutableStateOf(demonstrations.first())
    }

    val home: () -> Unit = {
        screen = Screen.HOME
    }

    val back: () -> Unit = {
        screen = when (screen) {
            Screen.DESTINATION -> Screen.LAB_GUIDE
            Screen.DEMO_DETAIL -> Screen.DEMONSTRATIONS
            Screen.NAVIGATION -> Screen.DESTINATION
            Screen.WEBSITE -> Screen.LAB_INFO
            else -> Screen.HOME
        }
    }

    BackHandler(
        enabled = screen != Screen.HOME
    ) {
        back()
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Background)
            .windowInsetsPadding(WindowInsets.safeDrawing)
    ) {

        if (
            screen != Screen.WEBSITE &&
            screen != Screen.SAFETY_PRESENTATION
        ) {
            RemoteHeader(
                isHome = screen == Screen.HOME,
                language = language,
                onLanguageChange = {
                    language = it
                },
                onHome = home,
                onOperator = {
                    screen = Screen.OPERATOR
                }
            )
        }

        Box(
            modifier = Modifier
                .fillMaxWidth()
                .weight(1f)
        ) {
            when (screen) {

                Screen.HOME -> HomeScreen(
                    language = language,
                    onNavigate = {
                        screen = it
                    }
                )

                Screen.SAFETY_PRESENTATION ->
                    SafetyPresentationScreen(
                        onHome = home
                    )

                Screen.LAB_GUIDE -> CatalogScreen(
                    title = "Lab Guide",
                    subtitle = "Where would you like to go?",
                    items = destinations,
                    onBack = back,
                    onSelect = {
                        selectedDestination = it
                        screen = Screen.DESTINATION
                    }
                )

                Screen.DESTINATION -> DetailScreen(
                    item = selectedDestination,
                    onBack = back,
                    actionLabel =
                        if (
                            selectedDestination.title ==
                            "Coffee Machine"
                        ) {
                            "Preview Navigation"
                        } else {
                            null
                        },
                    onAction = {
                        screen = Screen.NAVIGATION
                    }
                )

                Screen.DEMONSTRATIONS -> CatalogScreen(
                    title = "Robot Demonstrations",
                    subtitle = "Discover the G1 visitor experience",
                    items = demonstrations,
                    onBack = back,
                    onSelect = {
                        selectedDemo = it
                        screen = Screen.DEMO_DETAIL
                    }
                )

                Screen.DEMO_DETAIL -> DetailScreen(
                    item = selectedDemo,
                    onBack = back,
                    actionLabel = null,
                    onAction = {}
                )

                Screen.LAB_MAP -> LabMapScreen(
                    onBack = back
                )

                Screen.LAB_INFO -> LabInfoScreen(
                    onBack = back,
                    onWebsite = {
                        screen = Screen.WEBSITE
                    }
                )

                Screen.WEBSITE -> FullScreenWebsite(
                    onHome = home,
                    onBack = back
                )

                Screen.NAVIGATION -> NavigationPreview(
                    onBack = back
                )

                // NEW: Talk to G1
                Screen.VOICE -> TalkToG1Screen(
                    language = language,
                    onBack = back
                )

                // Existing operator control remains.
                Screen.OPERATOR -> G1RemoteOperatorPreviewScreen(
                    onBack = back,
                    onHome = home
                )
            }
        }
    }
}

// ======================================================
// ORIGINAL HEADER + LANGUAGE SELECTOR
// ======================================================

@Composable
private fun RemoteHeader(
    isHome: Boolean,
    language: AppLanguage,
    onLanguageChange: (AppLanguage) -> Unit,
    onHome: () -> Unit,
    onOperator: () -> Unit
) {

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .height(66.dp)
            .background(Color(0xFFF0F3F1))
            .padding(horizontal = 18.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {

        Image(
            painter = painterResource(R.drawable.hfu_logo),
            contentDescription = "HFU",
            modifier = Modifier
                .width(135.dp)
                .height(48.dp),
            contentScale = ContentScale.Fit
        )

        Spacer(Modifier.width(15.dp))

        Column(
            modifier = Modifier.weight(1f)
        ) {

            Text(
                "G1 Remote",
                color = Green,
                fontWeight = FontWeight.Bold,
                fontSize = 22.sp
            )

            Text(
                INSTITUTE,
                color = Dark,
                fontSize = 11.sp,
                maxLines = 1,
                overflow = TextOverflow.Ellipsis
            )
        }

        Column(
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            Text(
                "Offline",
                color = Green,
                fontWeight = FontWeight.Bold,
                fontSize = 12.sp
            )

            Text(
                "UI Preview",
                color = Muted,
                fontSize = 10.sp
            )
        }

        Spacer(Modifier.width(10.dp))

        // NEW: Language selector
        Row(
            verticalAlignment = Alignment.CenterVertically
        ) {

            TextButton(
                onClick = {
                    onLanguageChange(AppLanguage.EN)
                }
            ) {
                Text(
                    "EN",
                    color = if (
                        language == AppLanguage.EN
                    ) Green else Muted,
                    fontWeight = if (
                        language == AppLanguage.EN
                    ) FontWeight.Bold
                    else FontWeight.Normal
                )
            }

            TextButton(
                onClick = {
                    onLanguageChange(AppLanguage.DE)
                }
            ) {
                Text(
                    "DE",
                    color = if (
                        language == AppLanguage.DE
                    ) Green else Muted,
                    fontWeight = if (
                        language == AppLanguage.DE
                    ) FontWeight.Bold
                    else FontWeight.Normal
                )
            }
        }

        Spacer(Modifier.width(12.dp))

        IconButton(
            onClick = {
                if (isHome) {
                    onOperator()
                } else {
                    onHome()
                }
            }
        ) {

            Icon(
                if (isHome) {
                    Icons.Default.Lock
                } else {
                    Icons.Default.Home
                },
                contentDescription = "Navigation",
                tint = Green
            )
        }
    }
}

