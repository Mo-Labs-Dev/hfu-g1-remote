                                    @Composable
                                    private fun ExpandableSection(
                                        title: String,
                                        description: String
                                    ) {
                                        var expanded by remember { mutableStateOf(false) }

                                        Card(
                                            modifier = Modifier
                                                .fillMaxWidth()
                                                .clickable { expanded = !expanded },
                                            colors = CardDefaults.cardColors(
                                                containerColor = Color.White
                                            ),
                                            shape = RoundedCornerShape(12.dp)
                                        ) {
                                            Column(
                                                modifier = Modifier.padding(14.dp)
                                            ) {
                                                Row(verticalAlignment = Alignment.CenterVertically) {
                                                    Text(
                                                        title,
                                                        modifier = Modifier.weight(1f),
                                                        color = Dark,
                                                        fontWeight = FontWeight.Bold
                                                    )

                                                    Icon(
                                                        if (expanded) Icons.Default.ExpandLess
                                                        else Icons.Default.ExpandMore,
                                                        null,
                                                        tint = Green
                                                    )
                                                }

                                                if (expanded) {
                                                    Spacer(Modifier.height(8.dp))

                                                    Text(
                                                        description,
                                                        color = Muted,
                                                        fontSize = 13.sp
                                                    )
                                                }
                                            }
                                        }
                                    }

// ======================================================
// HFU WEBSITE
// ======================================================

                                    @SuppressLint("SetJavaScriptEnabled")
                                    @Composable
                                    private fun FullScreenWebsite(
                                        onHome: () -> Unit,
                                        onBack: () -> Unit
                                    ) {
                                        var webView by remember {
                                            mutableStateOf<WebView?>(null)
                                        }

                                        DisposableEffect(Unit) {
                                            onDispose {
                                                webView?.stopLoading()
                                                webView?.destroy()
                                                webView = null
                                            }
                                        }

                                        Box(
                                            modifier = Modifier
                                                .fillMaxSize()
                                                .background(Color.White)
                                        ) {
                                            AndroidView(
                                                factory = { context ->
                                                    WebView(context).apply {
                                                        settings.javaScriptEnabled = true
                                                        settings.domStorageEnabled = true
                                                        webViewClient = WebViewClient()
                                                        webView = this
                                                        loadUrl(IPSE_URL)
                                                    }
                                                },
                                                modifier = Modifier.fillMaxSize()
                                            )

                                            Surface(
                                                modifier = Modifier
                                                    .align(Alignment.TopEnd)
                                                    .padding(12.dp),
                                                color = Color.White,
                                                shape = RoundedCornerShape(24.dp),
                                                shadowElevation = 6.dp
                                            ) {
                                                Row {
                                                    IconButton(
                                                        onClick = {
                                                            if (webView?.canGoBack() == true) {
                                                                webView?.goBack()
                                                            } else {
                                                                onBack()
                                                            }
                                                        }
                                                    ) {
                                                        Icon(Icons.Default.ArrowBack, "Back")
                                                    }

                                                    IconButton(
                                                        onClick = { webView?.reload() }
                                                    ) {
                                                        Icon(Icons.Default.Refresh, "Refresh")
                                                    }

                                                    IconButton(onClick = onHome) {
                                                        Icon(Icons.Default.Home, "Home")
                                                    }
                                                }
                                            }
                                        }
                                    }

// ======================================================
// NAVIGATION PREVIEW
// ======================================================

                                    @Composable
                                    private fun NavigationPreview(
                                        onBack: () -> Unit
                                    ) {
                                        var previewStarted by remember { mutableStateOf(false) }
                                        var step by remember { mutableIntStateOf(0) }

                                        val steps = listOf(
                                            "Ready",
                                            "Preparing",
                                            "Guiding",
                                            "Arrived",
                                            "Completed"
                                        )

                                        Column(
                                            modifier = Modifier
                                                .fillMaxSize()
                                                .verticalScroll(rememberScrollState())
                                                .padding(16.dp),
                                            verticalArrangement = Arrangement.spacedBy(14.dp)
                                        ) {
                                            ScreenTitle("Coffee Machine Navigation", onBack)

                                            Card(
                                                colors = CardDefaults.cardColors(
                                                    containerColor = Color.White
                                                ),
                                                shape = RoundedCornerShape(16.dp)
                                            ) {
                                                Column(
                                                    modifier = Modifier
                                                        .fillMaxWidth()
                                                        .padding(16.dp),
                                                    verticalArrangement = Arrangement.spacedBy(14.dp)
                                                ) {
                                                    Text(
                                                        "Visitor Guidance Preview",
                                                        color = Dark,
                                                        fontSize = 20.sp,
                                                        fontWeight = FontWeight.Bold
                                                    )

                                                    Text(
                                                        "Destination: Coffee Machine",
                                                        color = Green,
                                                        fontWeight = FontWeight.Bold
                                                    )

                                                    Row(
                                                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                                                    ) {
                                                        steps.forEachIndexed { index, title ->
                                                            Surface(
                                                                modifier = Modifier.weight(1f),
                                                                color = if (index <= step)
                                                                    Mint else Background,
                                                                shape = RoundedCornerShape(10.dp)
                                                            ) {
                                                                Column(
                                                                    modifier = Modifier.padding(10.dp),
                                                                    horizontalAlignment =
                                                                        Alignment.CenterHorizontally
                                                                ) {
                                                                    Icon(
                                                                        if (index < step)
                                                                            Icons.Default.CheckCircle
                                                                        else
                                                                            Icons.Default.RadioButtonUnchecked,
                                                                        null,
                                                                        tint = if (index <= step)
                                                                            Green else Muted
                                                                    )

                                                                    Text(
                                                                        title,
                                                                        fontSize = 11.sp,
                                                                        color = Dark
                                                                    )
                                                                }
                                                            }
                                                        }
                                                    }

                                                    LinearProgressIndicator(
                                                        progress = { step / 4f },
                                                        modifier = Modifier.fillMaxWidth(),
                                                        color = Green
                                                    )

                                                    Text(
                                                        "Current Stage: ${steps[step]}",
                                                        color = Green,
                                                        fontWeight = FontWeight.Bold
                                                    )

                                                    Row(
                                                        horizontalArrangement = Arrangement.spacedBy(10.dp)
                                                    ) {
                                                        Button(
                                                            onClick = {
                                                                previewStarted = true
                                                                step = (step + 1).coerceAtMost(4)
                                                            },
                                                            enabled = step < 4
                                                        ) {
                                                            Text(
                                                                if (!previewStarted)
                                                                    "Start Preview"
                                                                else
                                                                    "Next Preview Step"
                                                            )
                                                        }

                                                        OutlinedButton(
                                                            onClick = {
                                                                previewStarted = false
                                                                step = 0
                                                            }
                                                        ) {
                                                            Text("Reset")
                                                        }
                                                    }
                                                }
                                            }

                                            Notice(
                                                "Navigation simulation only. No walking, " +
                                                        "localization or robot commands are active."
                                            )
                                        }
                                    }

// ======================================================
// OPERATOR CONTROL — UI SIMULATION
// ======================================================

                                    private enum class JoystickMotion(
                                        val title: String,
                                        val vx: Float,
                                        val vy: Float,
                                        val yaw: Float
                                    ) {
                                        STOP("STOPPED", 0f, 0f, 0f),
                                        FORWARD("FORWARD", 0.15f, 0f, 0f),
                                        BACKWARD("BACKWARD", -0.15f, 0f, 0f),
                                        LEFT("LEFT", 0f, 0.10f, 0f),
                                        RIGHT("RIGHT", 0f, -0.10f, 0f),
                                        TURN_LEFT("ROTATE LEFT", 0f, 0f, 0.20f),
                                        TURN_RIGHT("ROTATE RIGHT", 0f, 0f, -0.20f)
                                    }

                                    @Composable
                                    private fun G1RemoteOperatorPreviewScreen(
                                        onBack: () -> Unit,
                                        onHome: () -> Unit
                                    ) {
                                        var pin by remember { mutableStateOf("") }
                                        var unlocked by remember { mutableStateOf(false) }
                                        var invalidPin by remember { mutableStateOf(false) }
                                        var motion by remember {
                                            mutableStateOf(JoystickMotion.STOP)
                                        }

                                        var previewFsm by remember { mutableIntStateOf(0) }

                                        fun stopMotion() {
                                            motion = JoystickMotion.STOP
                                        }

                                        DisposableEffect(Unit) {
                                            onDispose {
                                                motion = JoystickMotion.STOP
                                            }
                                        }

                                        Column(
                                            modifier = Modifier
                                                .fillMaxSize()
                                                .verticalScroll(rememberScrollState())
                                                .padding(14.dp),
                                            verticalArrangement = Arrangement.spacedBy(12.dp)
                                        ) {
                                            Row(verticalAlignment = Alignment.CenterVertically) {
                                                OutlinedButton(
                                                    onClick = {
                                                        stopMotion()
                                                        onBack()
                                                    }
                                                ) {
                                                    Icon(Icons.Default.ArrowBack, null)
                                                    Text("Back")
                                                }

                                                Spacer(Modifier.width(12.dp))

                                                Text(
                                                    "G1 Operator Control",
                                                    modifier = Modifier.weight(1f),
                                                    color = Dark,
                                                    fontSize = 22.sp,
                                                    fontWeight = FontWeight.Bold
                                                )

                                                Text(
                                                    "OFFLINE · UI PREVIEW",
                                                    color = Green,
                                                    fontWeight = FontWeight.Bold,
                                                    fontSize = 12.sp
                                                )

                                                IconButton(
                                                    onClick = {
                                                        stopMotion()
                                                        onHome()
                                                    }
                                                ) {
                                                    Icon(Icons.Default.Home, "Home", tint = Green)
                                                }
                                            }

                                            Card(
                                                colors = CardDefaults.cardColors(
                                                    containerColor = Color.White
                                                )
                                            ) {
                                                Row(
                                                    modifier = Modifier
                                                        .fillMaxWidth()
                                                        .padding(12.dp),
                                                    verticalAlignment = Alignment.CenterVertically,
                                                    horizontalArrangement = Arrangement.spacedBy(12.dp)
                                                ) {
                                                    Icon(
                                                        if (unlocked) Icons.Default.LockOpen
                                                        else Icons.Default.Lock,
                                                        null,
                                                        tint = Green
                                                    )

                                                    Text(
                                                        if (unlocked)
                                                            "Operator Preview Unlocked"
                                                        else
                                                            "Operator Authentication",
                                                        modifier = Modifier.weight(1f),
                                                        color = Dark,
                                                        fontWeight = FontWeight.Bold
                                                    )

                                                    if (!unlocked) {
                                                        OutlinedTextField(
                                                            value = pin,
                                                            onValueChange = {
                                                                pin = it.filter(Char::isDigit).take(4)
                                                                invalidPin = false
                                                            },
                                                            modifier = Modifier.width(135.dp),
                                                            label = { Text("PIN") },
                                                            singleLine = true,
                                                            isError = invalidPin,
                                                            visualTransformation =
                                                                PasswordVisualTransformation(),
                                                            keyboardOptions = KeyboardOptions(
                                                                keyboardType = KeyboardType.NumberPassword
                                                            )
                                                        )

                                                        Button(
                                                            onClick = {
                                                                if (pin == "1234") {
                                                                    unlocked = true
                                                                    invalidPin = false
                                                                } else {
                                                                    invalidPin = true
                                                                    pin = ""
                                                                }
                                                            },
                                                            enabled = pin.length == 4
                                                        ) {
                                                            Text("Unlock")
                                                        }
                                                    } else {
                                                        OutlinedButton(
                                                            onClick = {
                                                                stopMotion()
                                                                unlocked = false
                                                                previewFsm = 0
                                                                pin = ""
                                                            }
                                                        ) {
                                                            Icon(Icons.Default.Lock, null)
                                                            Text("Lock")
                                                        }
                                                    }
                                                }
                                            }

                                            if (invalidPin) {
                                                Text(
                                                    "Incorrect PIN",
                                                    color = Color.Red,
                                                    fontSize = 12.sp
                                                )
                                            }

                                            Card(
                                                colors = CardDefaults.cardColors(
                                                    containerColor = Color.White
                                                )
                                            ) {
                                                Column(
                                                    modifier = Modifier
                                                        .fillMaxWidth()
                                                        .padding(12.dp),
                                                    verticalArrangement = Arrangement.spacedBy(12.dp)
                                                ) {
                                                    Text(
                                                        "Robot FSM Modes — Preview",
                                                        color = Dark,
                                                        fontWeight = FontWeight.Bold,
                                                        fontSize = 17.sp
                                                    )

                                                    Row(
                                                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                                                    ) {
                                                        listOf(
                                                            0 to "Zero Torque",
                                                            1 to "Damp",
                                                            4 to "Stand Up",
                                                            500 to "Locomotion"
                                                        ).forEach { (fsm, label) ->
                                                            Surface(
                                                                modifier = Modifier.weight(1f),
                                                                color = if (previewFsm == fsm)
                                                                    Mint else Background,
                                                                shape = RoundedCornerShape(10.dp),
                                                                border = androidx.compose.foundation.BorderStroke(
                                                                    1.dp,
                                                                    if (previewFsm == fsm)
                                                                        Green else BorderColor
                                                                )
                                                            ) {
                                                                Column(
                                                                    modifier = Modifier.padding(10.dp),
                                                                    horizontalAlignment =
                                                                        Alignment.CenterHorizontally
                                                                ) {
                                                                    Text(
                                                                        "FSM $fsm",
                                                                        color = Green,
                                                                        fontWeight = FontWeight.Bold,
                                                                        fontSize = 17.sp
                                                                    )

                                                                    Text(
                                                                        label,
                                                                        color = Dark,
                                                                        fontSize = 11.sp
                                                                    )
                                                                }
                                                            }
                                                        }
                                                    }

                                                    Text(
                                                        "Preview sequence: FSM 0 → 1 → 4 → 500",
                                                        color = Muted,
                                                        fontSize = 11.sp
                                                    )

                                                    Row(
                                                        horizontalArrangement = Arrangement.spacedBy(10.dp)
                                                    ) {
                                                        Button(
                                                            onClick = {
                                                                stopMotion()
                                                                previewFsm = 1
                                                            },
                                                            enabled = unlocked && previewFsm == 0,
                                                            modifier = Modifier.weight(1f)
                                                        ) {
                                                            Text("FSM 1 · Damp")
                                                        }

                                                        Button(
                                                            onClick = {
                                                                stopMotion()
                                                                previewFsm = 4
                                                            },
                                                            enabled = unlocked && previewFsm == 1,
                                                            modifier = Modifier.weight(1f)
                                                        ) {
                                                            Text("FSM 4 · Stand")
                                                        }

                                                        Button(
                                                            onClick = {
                                                                stopMotion()
                                                                previewFsm = 500
                                                            },
                                                            enabled = unlocked && previewFsm == 4,
                                                            modifier = Modifier.weight(1f)
                                                        ) {
                                                            Text("FSM 500 · Locomotion")
                                                        }

                                                        OutlinedButton(
                                                            onClick = {
                                                                stopMotion()
                                                                previewFsm = 0
                                                            },
                                                            enabled = unlocked
                                                        ) {
                                                            Text("Reset")
                                                        }
                                                    }
                                                }
                                            }

                                            val joystickEnabled =
                                                unlocked && previewFsm == 500

                                            Row(
                                                modifier = Modifier.fillMaxWidth(),
                                                horizontalArrangement = Arrangement.spacedBy(12.dp)
                                            ) {
                                                Card(
                                                    modifier = Modifier.weight(1.3f),
                                                    colors = CardDefaults.cardColors(
                                                        containerColor = Color.White
                                                    )
                                                ) {
                                                    Column(
                                                        modifier = Modifier
                                                            .fillMaxWidth()
                                                            .padding(12.dp),
                                                        horizontalAlignment = Alignment.CenterHorizontally,
                                                        verticalArrangement = Arrangement.spacedBy(8.dp)
                                                    ) {
                                                        Text(
                                                            "Walking Joystick",
                                                            color = Dark,
                                                            fontWeight = FontWeight.Bold
                                                        )

                                                        HoldJoystickButton(
                                                            "Forward",
                                                            Icons.Default.ArrowUpward,
                                                            joystickEnabled,
                                                            motion == JoystickMotion.FORWARD,
                                                            { motion = JoystickMotion.FORWARD },
                                                            { stopMotion() }
                                                        )

                                                        Row(
                                                            horizontalArrangement = Arrangement.spacedBy(8.dp),
                                                            verticalAlignment = Alignment.CenterVertically
                                                        ) {
                                                            HoldJoystickButton(
                                                                "Left",
                                                                Icons.Default.ArrowBack,
                                                                joystickEnabled,
                                                                motion == JoystickMotion.LEFT,
                                                                { motion = JoystickMotion.LEFT },
                                                                { stopMotion() }
                                                            )

                                                            Button(
                                                                onClick = { stopMotion() },
                                                                modifier = Modifier
                                                                    .width(100.dp)
                                                                    .height(64.dp),
                                                                colors = ButtonDefaults.buttonColors(
                                                                    containerColor = Color(0xFFB3261E)
                                                                )
                                                            ) {
                                                                Column(
                                                                    horizontalAlignment =
                                                                        Alignment.CenterHorizontally
                                                                ) {
                                                                    Icon(Icons.Default.Stop, null)
                                                                    Text("STOP", fontSize = 11.sp)
                                                                }
                                                            }

                                                            HoldJoystickButton(
                                                                "Right",
                                                                Icons.Default.ArrowForward,
                                                                joystickEnabled,
                                                                motion == JoystickMotion.RIGHT,
                                                                { motion = JoystickMotion.RIGHT },
                                                                { stopMotion() }
                                                            )
                                                        }

                                                        HoldJoystickButton(
                                                            "Backward",
                                                            Icons.Default.ArrowDownward,
                                                            joystickEnabled,
                                                            motion == JoystickMotion.BACKWARD,
                                                            { motion = JoystickMotion.BACKWARD },
                                                            { stopMotion() }
                                                        )
                                                    }
                                                }

                                                Card(
                                                    modifier = Modifier.weight(0.8f),
                                                    colors = CardDefaults.cardColors(
                                                        containerColor = Color.White
                                                    )
                                                ) {
                                                    Column(
                                                        modifier = Modifier
                                                            .fillMaxWidth()
                                                            .padding(12.dp),
                                                        horizontalAlignment = Alignment.CenterHorizontally,
                                                        verticalArrangement = Arrangement.spacedBy(14.dp)
                                                    ) {
                                                        Text(
                                                            "Rotation",
                                                            color = Dark,
                                                            fontWeight = FontWeight.Bold
                                                        )

                                                        HoldJoystickButton(
                                                            "Rotate Left",
                                                            Icons.Default.RotateLeft,
                                                            joystickEnabled,
                                                            motion == JoystickMotion.TURN_LEFT,
                                                            { motion = JoystickMotion.TURN_LEFT },
                                                            { stopMotion() },
                                                            wide = true
                                                        )

                                                        HoldJoystickButton(
                                                            "Rotate Right",
                                                            Icons.Default.RotateRight,
                                                            joystickEnabled,
                                                            motion == JoystickMotion.TURN_RIGHT,
                                                            { motion = JoystickMotion.TURN_RIGHT },
                                                            { stopMotion() },
                                                            wide = true
                                                        )

                                                        Text(
                                                            "Press and hold",
                                                            color = Muted,
                                                            fontSize = 11.sp
                                                        )
                                                    }
                                                }

                                                Card(
                                                    modifier = Modifier.weight(0.85f),
                                                    colors = CardDefaults.cardColors(
                                                        containerColor = Mint
                                                    )
                                                ) {
                                                    Column(
                                                        modifier = Modifier
                                                            .fillMaxWidth()
                                                            .padding(14.dp),
                                                        verticalArrangement = Arrangement.spacedBy(10.dp)
                                                    ) {
                                                        Text(
                                                            "Motion Preview",
                                                            color = Dark,
                                                            fontWeight = FontWeight.Bold
                                                        )

                                                        Text(
                                                            motion.title,
                                                            color = Green,
                                                            fontWeight = FontWeight.Bold,
                                                            fontSize = 18.sp
                                                        )

                                                        Text("vx: %.2f m/s".format(motion.vx))
                                                        Text("vy: %.2f m/s".format(motion.vy))
                                                        Text("yaw: %.2f rad/s".format(motion.yaw))

                                                        HorizontalDivider()

                                                        Text(
                                                            "Actual robot FSM: Unknown",
                                                            color = Muted,
                                                            fontSize = 11.sp
                                                        )

                                                        Text(
                                                            "Robot: Not connected",
                                                            color = Muted,
                                                            fontSize = 11.sp
                                                        )

                                                        Text(
                                                            "Physical motion: DISABLED",
                                                            color = Color(0xFF9D4B00),
                                                            fontSize = 11.sp
                                                        )
                                                    }
                                                }
                                            }

                                            Notice(
                                                "Demo PIN 1234 unlocks the UI only. " +
                                                        "No commands are sent to G1. " +
                                                        "On-screen STOP is not an emergency stop."
                                            )
                                        }
                                    }

// ======================================================
// PRESS-AND-HOLD JOYSTICK BUTTON
// ======================================================

                                    @Composable
                                    private fun HoldJoystickButton(
                                        title: String,
                                        icon: androidx.compose.ui.graphics.vector.ImageVector,
                                        enabled: Boolean,
                                        active: Boolean,
                                        onPress: () -> Unit,
                                        onRelease: () -> Unit,
                                        wide: Boolean = false
                                    ) {
                                        val shape = RoundedCornerShape(12.dp)

                                        val backgroundColor = when {
                                            !enabled -> Color(0xFFE6E9E7)
                                            active -> Green
                                            else -> Mint
                                        }

                                        val foregroundColor = when {
                                            !enabled -> Color.Gray
                                            active -> Color.White
                                            else -> Green
                                        }

                                        val latestPress by rememberUpdatedState(onPress)
                                        val latestRelease by rememberUpdatedState(onRelease)

                                        Column(
                                            modifier = Modifier
                                                .width(if (wide) 155.dp else 96.dp)
                                                .height(64.dp)
                                                .background(backgroundColor, shape)
                                                .border(1.dp, BorderColor, shape)
                                                .pointerInput(enabled) {
                                                    if (enabled) {
                                                        detectTapGestures(
                                                            onPress = {
                                                                latestPress()
                                                                try {
                                                                    tryAwaitRelease()
                                                                } finally {
                                                                    latestRelease()
                                                                }
                                                            }
                                                        )
                                                    }
                                                },
                                            horizontalAlignment = Alignment.CenterHorizontally,
                                            verticalArrangement = Arrangement.Center
                                        ) {
                                            Icon(
                                                icon,
                                                contentDescription = title,
                                                tint = foregroundColor
                                            )

                                            Text(
                                                title,
                                                color = foregroundColor,
                                                fontSize = 11.sp,
                                                fontWeight = FontWeight.Bold
                                            )
                                        }
                                    }

// ======================================================
// NEW: TALK TO G1
// ======================================================

                                    @Composable
                                    private fun TalkToG1Screen(
                                        language: AppLanguage,
                                        onBack: () -> Unit
                                    ) {
                                        var message by remember {
                                            mutableStateOf("")
                                        }

                                        var microphonePreview by remember {
                                            mutableStateOf(false)
                                        }

                                        var messages by remember {
                                            mutableStateOf(
                                                listOf(
                                                    "G1" to "Hello! I'm G1. How can I help you?"
                                                )
                                            )
                                        }

                                        fun send(text: String) {
                                            if (text.isBlank()) return

                                            messages = messages + ("Visitor" to text.trim())

                                            messages = messages + (
                                                    "G1" to tr(
                                                        language,
                                                        "This is a preview. My AI voice service " +
                                                                "will be connected through G1 Studio.",
                                                        "Dies ist eine Vorschau. Mein KI-Sprachdienst " +
                                                                "wird später mit G1 Studio verbunden."
                                                    )
                                                    )

                                            message = ""
                                        }

                                        Column(
                                            modifier = Modifier
                                                .fillMaxSize()
                                                .verticalScroll(rememberScrollState())
                                                .padding(16.dp),
                                            verticalArrangement = Arrangement.spacedBy(14.dp)
                                        ) {
                                            ScreenTitle(
                                                tr(
                                                    language,
                                                    "Talk to G1",
                                                    "Mit G1 sprechen"
                                                ),
                                                onBack
                                            )

                                            Row(
                                                modifier = Modifier.fillMaxWidth(),
                                                horizontalArrangement = Arrangement.spacedBy(14.dp)
                                            ) {
                                                Card(
                                                    modifier = Modifier.weight(0.9f),
                                                    colors = CardDefaults.cardColors(
                                                        containerColor = Color.White
                                                    ),
                                                    shape = RoundedCornerShape(16.dp)
                                                ) {
                                                    Column(
                                                        modifier = Modifier
                                                            .fillMaxWidth()
                                                            .padding(18.dp),
                                                        horizontalAlignment = Alignment.CenterHorizontally,
                                                        verticalArrangement = Arrangement.spacedBy(12.dp)
                                                    ) {
                                                        Icon(
                                                            Icons.Default.Mic,
                                                            contentDescription = null,
                                                            tint = Green,
                                                            modifier = Modifier.size(55.dp)
                                                        )

                                                        Text(
                                                            tr(
                                                                language,
                                                                "G1 Voice Assistant",
                                                                "G1 Sprachassistent"
                                                            ),
                                                            color = Dark,
                                                            fontSize = 19.sp,
                                                            fontWeight = FontWeight.Bold
                                                        )

                                                        Text(
                                                            if (microphonePreview) {
                                                                tr(
                                                                    language,
                                                                    "Listening Preview",
                                                                    "Hörvorschau"
                                                                )
                                                            } else {
                                                                tr(
                                                                    language,
                                                                    "Ready",
                                                                    "Bereit"
                                                                )
                                                            },
                                                            color = Green
                                                        )

                                                        Button(
                                                            onClick = {
                                                                microphonePreview = !microphonePreview
                                                            },
                                                            modifier = Modifier.fillMaxWidth()
                                                        ) {
                                                            Icon(
                                                                if (microphonePreview)
                                                                    Icons.Default.Stop
                                                                else
                                                                    Icons.Default.Mic,
                                                                null
                                                            )

                                                            Spacer(Modifier.width(8.dp))

                                                            Text(
                                                                if (microphonePreview) {
                                                                    tr(
                                                                        language,
                                                                        "Stop Preview",
                                                                        "Vorschau stoppen"
                                                                    )
                                                                } else {
                                                                    tr(
                                                                        language,
                                                                        "Microphone Preview",
                                                                        "Mikrofonvorschau"
                                                                    )
                                                                }
                                                            )
                                                        }

                                                        Text(
                                                            tr(
                                                                language,
                                                                "Microphone and speech recognition " +
                                                                        "are not connected yet.",
                                                                "Mikrofon und Spracherkennung " +
                                                                        "sind noch nicht verbunden."
                                                            ),
                                                            color = Muted,
                                                            fontSize = 12.sp
                                                        )
                                                    }
                                                }

                                                Card(
                                                    modifier = Modifier.weight(1.4f),
                                                    colors = CardDefaults.cardColors(
                                                        containerColor = Color.White
                                                    ),
                                                    shape = RoundedCornerShape(16.dp)
                                                ) {
                                                    Column(
                                                        modifier = Modifier
                                                            .fillMaxWidth()
                                                            .padding(14.dp),
                                                        verticalArrangement = Arrangement.spacedBy(12.dp)
                                                    ) {
                                                        Text(
                                                            tr(
                                                                language,
                                                                "Conversation",
                                                                "Unterhaltung"
                                                            ),
                                                            color = Dark,
                                                            fontSize = 18.sp,
                                                            fontWeight = FontWeight.Bold
                                                        )

                                                        Column(
                                                            modifier = Modifier
                                                                .fillMaxWidth()
                                                                .height(180.dp)
                                                                .verticalScroll(rememberScrollState()),
                                                            verticalArrangement = Arrangement.spacedBy(8.dp)
                                                        ) {
                                                            messages.forEach { (speaker, content) ->
                                                                Surface(
                                                                    color = if (speaker == "G1")
                                                                        Mint else Background,
                                                                    shape = RoundedCornerShape(12.dp)
                                                                ) {
                                                                    Column(
                                                                        modifier = Modifier
                                                                            .fillMaxWidth()
                                                                            .padding(10.dp)
                                                                    ) {
                                                                        Text(
                                                                            speaker,
                                                                            color = Green,
                                                                            fontWeight = FontWeight.Bold,
                                                                            fontSize = 11.sp
                                                                        )

                                                                        Text(
                                                                            content,
                                                                            color = Dark,
                                                                            fontSize = 12.sp
                                                                        )
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        Row(
                                                            verticalAlignment = Alignment.CenterVertically
                                                        ) {
                                                            OutlinedTextField(
                                                                value = message,
                                                                onValueChange = {
                                                                    message = it
                                                                },
                                                                label = {
                                                                    Text(
                                                                        tr(
                                                                            language,
                                                                            "Type a message",
                                                                            "Nachricht eingeben"
                                                                        )
                                                                    )
                                                                },
                                                                modifier = Modifier.weight(1f),
                                                                singleLine = true
                                                            )

                                                            Spacer(Modifier.width(8.dp))

                                                            Button(
                                                                onClick = {
                                                                    send(message)
                                                                },
                                                                enabled = message.isNotBlank()
                                                            ) {
                                                                Icon(
                                                                    Icons.Default.Send,
                                                                    contentDescription = "Send"
                                                                )
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Notice(
                                                tr(
                                                    language,
                                                    "Voice UI preview only. No audio recording, " +
                                                            "AI service or robot command is connected.",
                                                    "Nur eine Vorschau. Audioaufnahme, " +
                                                            "KI-Dienst und Roboterbefehle " +
                                                            "sind nicht verbunden."
                                                )
                                            )
                                        }
                                    }



                                    fontSize = 11.sp
                                    )

                                    Text(
                                        content,
                                        color = Dark,
                                        fontSize = 12.sp
                                    )
                                }
                            }
                        }
                    }

                    Row(
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        OutlinedTextField(
                            value = message,
                            onValueChange = {
                                message = it
                            },
                            label = {
                                Text(
                                    tr(
                                        language,
                                        "Type a message",
                                        "Nachricht eingeben"
                                    )
                                )
                            },
                            modifier = Modifier.weight(1f),
                            singleLine = true
                        )

                        Spacer(Modifier.width(8.dp))

                        Button(
                            onClick = {
                                send(message)
                            },
                            enabled = message.isNotBlank()
                        ) {
                            Icon(
                                Icons.Default.Send,
                                contentDescription = "Send"
                            )
                        }
                    }
                }
            }
        }

        Notice(
            tr(
                language,
                "Voice UI preview only. No audio recording, " +
                        "AI service or robot command is connected.",
                "Nur eine Vorschau. Audioaufnahme, " +
                        "KI-Dienst und Roboterbefehle " +
                        "sind nicht verbunden."
            )
        )
    }
}



