                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(9.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {

                            Text(
                                card.title,
                                modifier = Modifier.weight(1f),
                                fontSize = 12.sp,
                                fontWeight = FontWeight.Bold,
                                color = Dark,
                                maxLines = 2,
                                lineHeight = 14.sp
                            )

                            Icon(
                                Icons.Default.ArrowForward,
                                contentDescription = null,
                                tint = Green,
                                modifier = Modifier.size(16.dp)
                            )
                        }
                    }
                }
            }
        }

        Notice(
            "Visitor interface preview. Robot actions " +
                    "will be controlled by G1 Studio."
        )
    }
}


// ======================================================
// SAFETY PRESENTATION
// ======================================================

@Composable
private fun SafetyPresentationScreen(
    onHome: () -> Unit
) {
    var currentSlide by remember { mutableIntStateOf(0) }
    var playing by remember { mutableStateOf(false) }
    var finished by remember { mutableStateOf(false) }

    LaunchedEffect(playing, currentSlide) {
        if (playing) {
            delay(8000L)
            if (currentSlide < safetySlides.lastIndex) {
                currentSlide++
            } else {
                playing = false
                finished = true
            }
        }
    }

    val slide = safetySlides[currentSlide]

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.White)
            .padding(horizontal = 14.dp, vertical = 8.dp),
        verticalArrangement = Arrangement.spacedBy(7.dp)
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .height(42.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Icon(
                Icons.Default.HealthAndSafety,
                contentDescription = null,
                tint = Green
            )

            Spacer(Modifier.width(8.dp))

            Text(
                "HFU IPSE",
                color = Green,
                fontSize = 15.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(Modifier.width(12.dp))

            Text(
                "Laboratory Safety Presentation",
                modifier = Modifier.weight(1f),
                color = Dark,
                fontSize = 17.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                "${currentSlide + 1} / ${safetySlides.size}",
                color = Green,
                fontWeight = FontWeight.Bold
            )

            IconButton(
                onClick = {
                    playing = false
                    onHome()
                }
            ) {
                Icon(Icons.Default.Close, "Close")
            }
        }

        Box(
            modifier = Modifier
                .fillMaxWidth()
                .weight(1f)
                .clip(RoundedCornerShape(14.dp))
                .background(Mint)
        ) {
            Image(
                painter = painterResource(slide.image),
                contentDescription = slide.title,
                modifier = Modifier.fillMaxSize(),
                contentScale = ContentScale.Crop
            )

            Surface(
                modifier = Modifier
                    .align(Alignment.TopStart)
                    .padding(12.dp),
                color = Color.White.copy(alpha = 0.94f),
                shape = RoundedCornerShape(10.dp)
            ) {
                Text(
                    "VISITOR SAFETY · EXAMPLE",
                    modifier = Modifier.padding(10.dp),
                    color = Green,
                    fontWeight = FontWeight.Bold,
                    fontSize = 11.sp
                )
            }
        }

        Text(
            slide.title,
            color = Dark,
            fontSize = 23.sp,
            fontWeight = FontWeight.Bold
        )

        Text(
            slide.subtitle,
            color = Muted,
            fontSize = 12.sp
        )

        Surface(
            color = Mint,
            shape = RoundedCornerShape(10.dp)
        ) {
            Row(
                modifier = Modifier.padding(10.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Icon(
                    Icons.Default.RecordVoiceOver,
                    null,
                    tint = Green
                )

                Spacer(Modifier.width(10.dp))

                Column {
                    Text(
                        when {
                            finished -> "Preview completed"
                            playing -> "Narration preview · Playing"
                            else -> "Narration preview · Paused"
                        },
                        color = Green,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold
                    )

                    Text(
                        slide.narration,
                        color = Dark,
                        fontSize = 12.sp,
                        maxLines = 3,
                        overflow = TextOverflow.Ellipsis
                    )
                }
            }
        }

        LinearProgressIndicator(
            progress = {
                (currentSlide + 1).toFloat() /
                        safetySlides.size.toFloat()
            },
            modifier = Modifier.fillMaxWidth(),
            color = Green
        )

        Row(
            horizontalArrangement = Arrangement.spacedBy(10.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            OutlinedButton(
                onClick = {
                    playing = false
                    finished = false
                    currentSlide =
                        (currentSlide - 1).coerceAtLeast(0)
                },
                enabled = currentSlide > 0
            ) {
                Icon(Icons.Default.SkipPrevious, null)
                Text("Previous")
            }

            Button(
                onClick = {
                    if (finished) {
                        currentSlide = 0
                        finished = false
                        playing = true
                    } else {
                        playing = !playing
                    }
                }
            ) {
                Icon(
                    if (playing) Icons.Default.Pause
                    else Icons.Default.PlayArrow,
                    null
                )
                Text(
                    when {
                        finished -> "Replay"
                        playing -> "Pause"
                        else -> "Play Preview"
                    }
                )
            }

            OutlinedButton(
                onClick = {
                    playing = false
                    finished = false
                    currentSlide =
                        (currentSlide + 1)
                            .coerceAtMost(safetySlides.lastIndex)
                },
                enabled = currentSlide < safetySlides.lastIndex
            ) {
                Text("Next")
                Icon(Icons.Default.SkipNext, null)
            }

            Spacer(Modifier.weight(1f))

            Text(
                "8 sec / slide · No robot connection",
                color = Muted,
                fontSize = 10.sp
            )
        }
    }
}

// ======================================================
// SHARED COMPONENTS
// ======================================================

@Composable
private fun ScreenTitle(
    title: String,
    onBack: () -> Unit
) {
    Row(verticalAlignment = Alignment.CenterVertically) {
        OutlinedButton(onClick = onBack) {
            Icon(Icons.Default.ArrowBack, null)
            Spacer(Modifier.width(6.dp))
            Text("Back")
        }

        Spacer(Modifier.width(16.dp))

        Text(
            title,
            color = Dark,
            fontSize = 22.sp,
            fontWeight = FontWeight.Bold
        )
    }
}

@Composable
private fun Notice(text: String) {
    Surface(
        color = Mint,
        shape = RoundedCornerShape(12.dp)
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(12.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Icon(
                Icons.Default.Info,
                null,
                tint = Green
            )

            Spacer(Modifier.width(10.dp))

            Text(
                text,
                color = Dark,
                fontSize = 12.sp
            )
        }
    }
}

